define endian=little;
define alignment=1;

define space ram      type=ram_space      size=4  default;
define space register type=register_space size=4;

# General-purpose registers
define register offset=0x00 size=4
    [r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 sp r15 r16 r17 r18 r19 r20 r21 r22 r23 r24 r25 r26 r27 r28 r29 r30 r31];
#define register offset=0x00 size=4
#    [a0 a1 a2 a3 l0 l1 l2 l3 l4 l5 l6 l7 t0 t1 sp lr l8 l9 t2 t3 t4 t5 t6 t7 t8 t9 _ _ rdb rtb svbr tls];
@define r14 "sp"

# Acc registers
define register offset=0x100 size=4 [hi lo];

# Control registers (bank 0). The first row keeps its original offsets; the second adds the
# remaining cr<n,0> slots so mfcr/mtcr can name every index (see 32b.sinc, i32_cr_*).
define register offset=0x200 size=4 [PSR VBR EPSR FPSR EPC FPC GCR GSR CPID CCR CAPR PACR RID];
define register offset=0x240 size=4
    [SS0 SS1 SS2 SS3 SS4 DCSR CWR CFR CR18 CR22 CR23 CR24 CR25 CR26 CR27 CR28 CR29 CR30 CR31];
# Architectural PSR bits: C=0, AF=1, FE=4, IE=6, EE=8, S=31. This model keeps the carry flag at
# bit 31 instead (moving it to bit 0 makes Sleigh size it as a 1-byte varnode, which breaks the
# 4-byte reads of psr_cf in addc/subc), so a whole-PSR value read by mfcr shows C in the S position.
define bitrange psr_cf=PSR[31,1];

# Alternative registers
define register offset=0x300 size=4
    [r0a r1a r2a r3a r4a r5a r6a r7a r8a r9a r10a r11a r12a r13a r14a r15a r14_spv];
@define sp_spv "r14_spv"

# Program Counter
define register offset=0x2000 size=4 [pc];

define pcodeop stub;

macro push(x){
	sp = sp - 4;
	*:4 sp = x;
}
macro pop(x){
	x = *:4 sp;
	sp = sp + 4;
}